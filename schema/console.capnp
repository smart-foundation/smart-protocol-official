@0xa1b2c3d4e5f60044;

# ═══════════════════════════════════════════════════════════════════════
# Console — terminal I/O service.
#
# Zero-backend-assumption IPC contract for terminal interaction.
# No termcap, ncurses, xterm, VT100, or platform-specific terminal
# emulator assumed. The backend decides the terminal implementation;
# the protocol defines the contract.
#
# Improvements beyond the original schema (audit):
#   - KeyEvent.repeat (key held reporting).
#   - MouseEvent.motion (drag, hover without button press).
#   - MouseButton.scrollLeft/scrollRight (horizontal wheel).
#   - InputEvent.paste (bracketed paste).
#   - InputEvent.bell (terminal bell).
#   - TextStyle.hyperlink (terminal hyperlinks).
#   - CursorStyle enum + cursor style control.
#   - subscribeCursor for tracking (not just "after-the-fact").
#   - TerminalCapabilities for TERMCAP-style capability query.
#   - InputSubscription and CursorSubscription have cancel methods.
#   - All enums have other/custom variants for forward compatibility.
#   - InputEvent union has custom variant for forward compatibility.
# ═══════════════════════════════════════════════════════════════════════

using T = import "types.capnp";

# ── Input ───────────────────────────────────────────────────────────────

struct InputEvent {
    timestamp @0 :T.Timestamp;
    union {
        key @1 :KeyEvent;
        mouse @2 :MouseEvent;
        resize @3 :ResizeEvent;
        paste @4 :PasteEvent;
        bell @5 :Void;
        focus @6 :FocusChangeEvent;
        # Audit-7: new input event types for device-agnostic support
        stylus @8 :StylusInputEvent;
        eyeTracking @9 :EyeTrackingInputEvent;
        spatialGesture @10 :SpatialGestureInputEvent;
        # Backend-specific input event type.
        custom @7 :Data;
    }
}

struct KeyEvent {
    key @0 :Text;
    rawByte @1 :UInt8;
    modifiers @2 :T.ModifierState;
    pressed @3 :Bool;
    # Whether this event is generated by key repeat (held key).
    repeat @4 :Bool;
}

struct MouseEvent {
    position @0 :T.Vec2i;
    button @1 :MouseButton;
    pressed @2 :Bool;
    modifiers @3 :T.ModifierState;
    # Motion event: button was not pressed but pointer moved (hover/drag).
    motion @4 :Bool;
    # Delta from last position (for relative motion reporting).
    delta @5 :T.Vec2i;
}

enum MouseButton {
    left @0;
    middle @1;
    right @2;
    scrollUp @3;
    scrollDown @4;
    scrollLeft @5;
    scrollRight @6;
    other @7;
    # Backend-specific mouse button (e.g., extended buttons 8+).
    custom @8;
}

struct ResizeEvent {
    columns @0 :UInt32;
    rows @1 :UInt32;
}

struct PasteEvent {
    text @0 :Text;
    bracketed @1 :Bool;
}

struct FocusChangeEvent {
    focused @0 :Bool;
}

# ── Output ─────────────────────────────────────────────────────────────

struct StyledText {
    segments @0 :List(TextSegment);
}

struct TextSegment {
    text @0 :Text;
    style @1 :TextStyle;
}

struct TextStyle {
    foreground @0 :T.Color;
    background @1 :T.Color;
    bold @2 :Bool;
    dim @3 :Bool;
    italic @4 :Bool;
    underline @5 :Bool;
    strikethrough @6 :Bool;
    # Hyperlink: URI displayed on hover/click.
    hyperlink @7 :HyperlinkStyle;
}

struct HyperlinkStyle {
    url @0 :Text;
    id @1 :Text;
}

# ── Terminal Control ────────────────────────────────────────────────────

struct CursorPosition {
    column @0 :UInt32;
    row @1 :UInt32;
}

enum CursorStyle {
    block @0;
    underline @1;
    bar @2;
    other @3;
    # Backend-specific cursor style.
    custom @4;
}

struct TerminalInfo {
    columns @0 :UInt32;
    rows @1 :UInt32;
    supportsColor @2 :Bool;
    supportsMouse @3 :Bool;
    # Backend-decided terminal type identifier (e.g., "xterm", "vt100").
    terminalType @4 :Text;
    # Audit-7: console mode (what kind of console this is).
    consoleMode @5 :ConsoleMode;
    # Audit-7: available output capabilities.
    outputCapabilities @6 :List(OutputCapability);
    # Audit-7: available input capabilities.
    inputCapabilities @7 :List(InputCapability);
}

# Audit-7: console mode — declares what kind of console backend this is.
enum ConsoleMode {
    terminal @0;           # Traditional terminal (character grid)
    voice @1;              # Voice-only / screenless device
    braille @2;            # Refreshable braille display
    spatial @3;            # AR/VR spatial display
    haptic @4;             # Haptic-only output
    instrumentCluster @5;  # Car instrument cluster (fixed-zone gauges)
    custom @6;
}

# Audit-7: granular output capability advertisement.
enum OutputCapability {
    text @0;           # Plain text output
    styledText @1;     # Styled/rich text output
    audio @2;          # Audio/speech output
    haptic @3;         # Haptic vibration output
    spatial @4;        # 3D spatial text placement
    braille @5;        # Refreshable braille display
    avatar @6;         # Sign-language avatar animation
    gauge @7;          # Fixed-zone gauge/instrument output
    custom @8;
}

# Audit-7: granular input capability advertisement.
enum InputCapability {
    keyboard @0;        # Keyboard input
    mouse @1;           # Mouse/trackpad input
    stylus @2;          # Stylus/pen input with pressure
    eyeTracking @3;     # Eye-tracking gaze input
    spatialGesture @4;  # Hand/spatial gesture input
    hapticButton @5;    # Haptic button input
    voice @6;           # Voice/speech input
    brailleKeyboard @7; # Braille keyboard input
    custom @8;
}

# Audit-7: audio output event for voice-only devices.
struct AudioOutputEvent {
    # Text to speak.
    text @0 :Text;
    # Voice identifier (backend-specific).
    voice @1 :Text;
    # Language for speech synthesis.
    language @2 :T.Language;
    # Speech rate (1.0 = normal).
    rate @3 :Float32;
}

# Audit-7: spatial output event for AR/VR.
struct SpatialOutputEvent {
    # 3D position for text placement.
    position @0 :T.Point3D;
    # Text to display in 3D space.
    text @1 :Text;
    # Text styling.
    style @2 :TextStyle;
    # How long the text should remain visible.
    lifetime @3 :T.Duration;
}

# Audit-7: haptic output event for vibration-based communication.
struct HapticOutputEvent {
    # Sequence of pulses in the haptic pattern.
    pattern @0 :List(HapticPulse);
    # Number of times to repeat the pattern (0 = once).
    repeat @1 :UInt32;
}

# Audit-7: individual haptic pulse.
struct HapticPulse {
    # Pulse intensity (0.0 - 1.0).
    intensity @0 :Float32;
    # Pulse duration.
    duration @1 :T.Duration;
}

# Audit-7: braille output event for refreshable displays.
struct BrailleOutputEvent {
    # Braille cells to display (each byte encodes dot pattern).
    cells @0 :List(UInt8);
    # Cursor position in the braille display.
    cursorPosition @1 :UInt32;
}

# Audit-7: instrument cluster zone for car dashboards.
struct InstrumentClusterZone {
    # Zone identifier.
    id @0 :UInt32;
    # Human-readable zone name.
    name @1 :Text;
    # Zone type.
    kind @2 :InstrumentZoneKind;
}

enum InstrumentZoneKind {
    gauge @0;
    label @1;
    icon @2;
    graph @3;
    custom @4;
}

# Audit-7: stylus/pen input event.
struct StylusInputEvent {
    # Position on the surface.
    position @0 :T.Vec2i;
    # Pressure (0.0 - 1.0).
    pressure @1 :Float32;
    # Tilt angle.
    tilt @2 :T.Vec2;
    # Which button was pressed.
    button @3 :MouseButton;
    # Whether the stylus is in eraser mode.
    eraser @4 :Bool;
}

# Audit-7: eye-tracking gaze input event.
struct EyeTrackingInputEvent {
    # Gaze point on the screen.
    gazePoint @0 :T.Vec2;
    # Confidence in the gaze measurement (0.0 - 1.0).
    confidence @1 :Float32;
    # How long the user has been fixating on this point.
    fixationDuration @2 :T.Duration;
}

# Audit-7: spatial gesture input event for AR/VR.
struct SpatialGestureInputEvent {
    # Gesture name/identifier.
    gesture @0 :Text;
    # Hand position in 3D space.
    hand @1 :T.Vec3;
    # Confidence in the gesture recognition (0.0 - 1.0).
    confidence @2 :Float32;
}

# Audit-7: subtitle/caption entry for accessibility.
struct SubtitleEntry {
    # Subtitle text.
    text @0 :Text;
    # When the subtitle starts.
    startTime @1 :T.Timestamp;
    # When the subtitle ends.
    endTime @2 :T.Timestamp;
    # Language of the subtitle.
    language @3 :T.Language;
}

# Audit-7: output zone for multi-zone displays.
struct OutputZone {
    # Zone identifier.
    id @0 :UInt32;
    # Zone bounds on the display.
    bounds @1 :T.Rect;
    # Zone priority (higher = rendered on top).
    priority @2 :UInt32;
}

struct TerminalCapabilities {
    # Maximum color palette size (0 = monochrome, 256 = 256-color, 16777216 = true color).
    maxColors @0 :UInt32;
    # Whether styled text is supported.
    styledText @1 :Bool;
    # Whether hyperlinks are supported.
    hyperlinks @2 :Bool;
    # Whether bracketed paste mode is supported.
    bracketedPaste @3 :Bool;
    # Mouse modes supported.
    mouseModes @4 :List(MouseMode);
    # Whether the terminal tracks cursor position.
    cursorTracking @5 :Bool;
    # Whether the terminal supports Unicode combining characters.
    unicode @6 :Bool;
}

enum MouseMode {
    none @0;
    clickEvents @1;
    dragEvents @2;
    motionEvents @3;
    hiliteTracking @4;
    other @5;
    # Backend-specific mouse mode.
    custom @6;
}

enum ClearArea {
    all @0;
    above @1;
    below @2;
    line @3;
    lineToEnd @4;
    other @5;
    # Backend-specific clear area.
    custom @6;
}

# ── Service Interface ───────────────────────────────────────────────────

interface ConsoleService {
    readInput @0 () -> (event :InputEvent);

    subscribeInput @1 () -> (subscription :InputSubscription);

    writeText @2 (text :Text) -> T.VoidResult;
    writeStyled @3 (styled :StyledText) -> T.VoidResult;

    moveCursor @4 (position :CursorPosition) -> T.VoidResult;
    setCursorStyle @5 (style :CursorStyle) -> T.VoidResult;
    clear @6 (area :ClearArea) -> T.VoidResult;

    getInfo @7 () -> (info :TerminalInfo);
    getCursor @8 () -> (position :CursorPosition);
    getCapabilities @9 () -> (caps :TerminalCapabilities);

    subscribeCursor @10 () -> (subscription :CursorSubscription);

    bell @11 () -> T.VoidResult;

    # Audit-7: voice/speech output for screenless devices.
    writeAudio @12 (event :AudioOutputEvent) -> T.VoidResult;

    # Audit-7: 3D spatial text output for AR/VR.
    writeSpatial @13 (event :SpatialOutputEvent) -> T.VoidResult;

    # Audit-7: haptic vibration output.
    writeHaptic @14 (event :HapticOutputEvent) -> T.VoidResult;

    # Audit-7: braille display output.
    writeBraille @15 (event :BrailleOutputEvent) -> T.VoidResult;

    # Audit-7: instrument cluster zone update.
    writeGauge @16 (zoneId :UInt32, value :Text) -> T.VoidResult;

    # Audit-7: set preferred output language.
    setLanguage @17 (language :T.Language) -> T.VoidResult;

    # Audit-7: get current output language.
    getLanguage @18 () -> (language :T.Language);

    # Audit-7: send subtitle/caption text.
    writeSubtitle @19 (entry :SubtitleEntry) -> T.VoidResult;

    # Audit-7: target a specific output zone.
    setOutputZone @20 (zone :OutputZone) -> T.VoidResult;

    # Audit-9: console session recording.
    startRecording @21 () -> (session :ConsoleRecordingSession);
    stopRecording @22 (sessionId :UInt64) -> (session :ConsoleRecordingSession);
    pauseRecording @23 (sessionId :UInt64) -> T.VoidResult;
    resumeRecording @24 (sessionId :UInt64) -> T.VoidResult;
    playback @25 (sessionId :UInt64, fromTime :T.Timestamp) -> (events :List(InputEvent));
    exportRecording @26 (sessionId :UInt64, format :RecordingFormat) -> (data :T.DataHandle);
    deleteRecording @27 (sessionId :UInt64) -> T.VoidResult;
    listRecordings @28 (pagination :T.Pagination) -> (sessions :List(ConsoleRecordingSession), total :UInt64);

    # Audit-9: isolated sandbox session for untrusted apps.
    createSandbox @29 (config :ConsoleSandbox) -> (sandbox :ConsoleSandbox);
    destroySandbox @30 (sessionId :UInt64) -> T.VoidResult;
    getSandboxInfo @31 (sessionId :UInt64) -> (sandbox :ConsoleSandbox);

    # Audit-9: console power management.
    setPowerMode @32 (mode :ConsolePowerMode) -> T.VoidResult;

    # Audit-9: accessibility metadata for screen readers.
    setAccessibilityMetadata @33 (metadata :AccessibilityMetadata) -> T.VoidResult;

    # Audit-9: content format negotiation at session start.
    negotiateFormat @34 (clientFormats :List(OutputCapability)) -> (agreedFormat :OutputCapability);

    # Audit-9: error recovery after backend crash.
    recoverSession @35 () -> (session :ConsoleRecoveryInfo);

    # Audit-10: multi-window/multi-view support for multi-monitor setups.
    createWindow @36 (config :ConsoleWindowConfig) -> (window :ConsoleWindow);
    destroyWindow @37 (windowId :UInt64) -> T.VoidResult;
    getWindowInfo @38 (windowId :UInt64) -> (window :ConsoleWindow);
    listWindows @39 () -> (windows :List(ConsoleWindow));
    setActiveWindow @40 (windowId :UInt64) -> T.VoidResult;
    moveWindow @41 (windowId :UInt64, position :T.Vec2i) -> T.VoidResult;
    resizeWindow @42 (windowId :UInt64, size :T.Vec2i) -> T.VoidResult;

    # Audit-10: theme negotiation for dark/light mode preference.
    getThemePreference @43 () -> (theme :ThemePreference);
    setThemePreference @44 (theme :ThemePreference) -> T.VoidResult;
    subscribeTheme @45 () -> (subscription :ThemeSubscription);
}

interface ThemeSubscription {
    pull @0 () -> (theme :ThemePreference);
    cancel @1 () -> T.VoidResult;
}

# ── Audit-10: Multi-Window Support ──────────────────────────────────────
# Per-window operations for multi-monitor setups. Each window has
# independent input/output buffer and can be positioned on different
# displays.
struct ConsoleWindow {
    windowId @0 :UInt64;
    name @1 :Text;
    position @2 :T.Vec2i;
    size @3 :T.Vec2i;
    displayId @4 :UInt32;
    isActive @5 :Bool;
    isVisible @6 :Bool;
    consoleMode @7 :ConsoleMode;
    allowedCapabilities @8 :List(OutputCapability);
}

struct ConsoleWindowConfig {
    name @0 :Text;
    position @1 :T.Vec2i;
    size @2 :T.Vec2i;
    displayId @3 :UInt32;
    consoleMode @4 :ConsoleMode;
    allowedCapabilities @5 :List(OutputCapability);
}

# ── Audit-10: Theme Preference ───────────────────────────────────────────
# Theme negotiation for dark/light mode and accessibility preferences.
struct ThemePreference {
    mode @0 :ThemeMode;
    # High contrast mode for accessibility.
    highContrast @1 :Bool;
    # Reduced motion preference.
    reduceMotion @2 :Bool;
    # Preferred color saturation (0.0 = grayscale, 1.0 = full color).
    saturation @3 :Float32;
    # Font scale factor for accessibility.
    fontScale @4 :Float32;
}

enum ThemeMode {
    light @0;
    dark @1;
    auto @2;          # Follow system preference
    custom @3;
}

interface InputSubscription {
    pull @0 () -> (events :List(InputEvent), total :UInt32);

    # Explicitly cancel this subscription and release resources.
    cancel @1 () -> T.VoidResult;
}

interface CursorSubscription {
    pull @0 () -> (position :CursorPosition);

    # Explicitly cancel this subscription and release resources.
    cancel @1 () -> T.VoidResult;
}

# ── Audit-9: Console Recording ─────────────────────────────────────────
# Session recording, playback, and export for testing, accessibility,
# and compliance. Records input/output timeline for later replay.

struct ConsoleRecordingSession {
    sessionId @0 :UInt64;
    startTime @1 :T.Timestamp;
    # Total events captured.
    eventCount @2 :UInt64;
    # Total input events.
    inputCount @3 :UInt64;
    # Total output events.
    outputCount @4 :UInt64;
    # Whether recording is currently active.
    active @5 :Bool;
}

enum RecordingFormat {
    binary @0;     # Native format for playback
    text @1;       # Plain text transcript
    json @2;       # JSON for tooling
    custom @3;
}

interface ConsoleRecording {
    # Start recording a new session.
    startRecording @0 () -> (session :ConsoleRecordingSession);

    # Stop recording and finalize the session.
    stopRecording @1 (sessionId :UInt64) -> (session :ConsoleRecordingSession);

    # Pause an active recording.
    pauseRecording @2 (sessionId :UInt64) -> T.VoidResult;

    # Resume a paused recording.
    resumeRecording @3 (sessionId :UInt64) -> T.VoidResult;

    # Play back a recorded session.
    playback @4 (sessionId :UInt64, fromTime :T.Timestamp) -> (events :List(InputEvent));

    # Export a session to a specific format.
    exportRecording @5 (sessionId :UInt64, format :RecordingFormat) -> (data :T.DataHandle);

    # Delete a recorded session.
    deleteRecording @6 (sessionId :UInt64) -> T.VoidResult;

    # List all recorded sessions.
    listRecordings @7 (pagination :T.Pagination) -> (sessions :List(ConsoleRecordingSession), total :UInt64);
}

# ── Audit-9: Console Sandboxing ─────────────────────────────────────────
# Isolated console sessions for untrusted apps. Each sandboxed session
# has its own input/output buffer and cannot interfere with other sessions.
struct ConsoleSandbox {
    sessionId @0 :UInt64;
    isIsolated @1 :Bool;
    maxOutputRate @2 :UInt32;
    allowedOutputCapabilities @3 :List(OutputCapability);
}

enum ConsolePowerMode {
    normal @0;
    dim @1;
    blank @2;
    sleep @3;
    custom @4;
}

struct AccessibilityMetadata {
    role @0 :AccessibilityRole;
    label @1 :Text;
    description @2 :Text;
    state @3 :List(Text);
}

enum AccessibilityRole {
    staticText @0;
    editableText @1;
    button @2;
    link @3;
    image @4;
    container @5;
    custom @6;
}

struct ConsoleRecoveryInfo {
    sessionId @0 :UInt64;
    lastCheckpoint @1 :T.Timestamp;
    pendingInput @2 :UInt32;
    pendingOutput @3 :UInt32;
}

# ═══════════════════════════════════════════════════════════════════════
# v0.0.2 additions — Virtual Terminal Multiplexing
#
# A kernel/OS typically needs multiple concurrent terminals:
#   - vc0..vc6 virtual consoles (text + framebuffer-bound)
#   - serial console (dedicated UART)
#   - log console (kernel-only)
#   - bootsplash console (early boot)
#
# The multiplexing service hands out a ConsoleSession per logical
# terminal. Sessions are independent input/output, may be focused
# one at a time, and may rebind to different output backends.
# ═══════════════════════════════════════════════════════════════════════

# ── Terminal Classes ────────────────────────────────────────
# Roles drive the multiplexing policy. Different roles have
# different priority, ownership, and rerouting rules.

enum TtyClass {
    # Framebuffer-bound text console (vc0..vcN). Switchable.
    virtualConsole @0;
    # GPU-backed graphical terminal (kernel-controlled).
    graphicalTerminal @1;
    # Dedicated UART, e.g. for headless servers / early boot.
    serialConsole @2;
    # Kernel-only output (klog). Read by privileged tools.
    kernelLogConsole @3;
    # Boot-time UI shown until DE takes over.
    bootSplash @4;
    # Emergency shell. Always available, even when others crash.
    safeModeShell @5;
    # Remote-attached terminal (SSH, IPMI, ...).
    remoteConsole @6;
    # Backend-defined role (e.g. hot-pluggable debug console).
    custom @7;
}

struct ConsoleSession {
    # Session identifier (kernel-issued, stable).
    handle @0 :UInt64;
    # Human label (e.g., "vc0", "ttyS0", "kmsg").
    label @1 :Text;
    class @2 :TtyClass;
    # Encoding for text I/O.
    encoding @3 :Text;
    # Logical geometry in cells.
    columns @4 :UInt32;
    rows @5 :UInt32;
    # Whether the session is currently held by a focus owner.
    focused @6 :Bool;
    # Current permissions — see ConsolePermission.
    permissions @7 :UInt32;
}

enum ConsolePermission {
    # Session accepts keyboard input.
    inputReadable @0;
    # Session accepts programmatic input.
    inputWritable @1;
    # Subscribers may read session output.
    outputReadable @2;
    # Subscribers may write to session output.
    outputWritable @3;
    # Session may be forcibly detached on session close.
    forceCloseable @4;
    # Backend-defined permission bit.
    custom @5;
}

# ── Multiplexing Service ─────────────────────────────────────
# Hands out sessions; arbitrates focus; routes I/O.

interface ConsoleMultiplexer {
    # List sessions currently available.
    listSessions @0 () -> (sessions :List(ConsoleSession));
    # Open a session by label.
    open @1 (label :Text) -> (session :ConsoleSession);
    # Close a session (releases its focus, releases any subscribers).
    close @2 (handle :UInt64) -> (result :T.VoidResult);
    # Read input from a session; cancels when closed.
    read @3 (handle :UInt64) -> (subscription :ConsoleInputSubscription);
    # Subscribe to a session's output stream.
    subscribe @4 (handle :UInt64) -> (subscription :ConsoleOutputSubscription);
    # Detach the current focus from its session.
    setFocus @5 (handle :UInt64) -> (result :T.VoidResult);
    # Get the currently-focused session.
    getFocus @6 () -> (handle :UInt64);
    # Subscribe to multiplexer events (open/close/focus change).
    subscribeMultiplexer @7 () -> (subscription :ConsoleMuxSubscription);
}

interface ConsoleInputSubscription {
    pull @0 () -> (events :List(InputEvent));
    cancel @1 () -> T.VoidResult;
}

interface ConsoleOutputSubscription {
    pull @0 () -> (events :List(ConsoleOutputEvent));
    cancel @1 () -> T.VoidResult;
}

interface ConsoleMuxSubscription {
    pull @0 () -> (events :List(ConsoleMuxEvent));
    cancel @1 () -> T.VoidResult;
}

struct ConsoleOutputEvent {
    at @0 :UInt64;
    # Plain text without styling for fidelity.
    text @1 :Text;
    # Optional styled output (e.g., ANSI, hyperlink).
    styled @2 :StyledText;
}

struct ConsoleMuxEvent {
    at @0 :UInt64;
    union {
        sessionOpened @1 :ConsoleSession;
        sessionClosed @2 :UInt64;
        focusChanged @3 :UInt64;
        sessionChanged @4 :ConsoleSession;
        custom @5 :Void;
    }
}
